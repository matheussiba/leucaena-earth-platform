# Google Maps JavaScript API key (required)
GOOGLE_MAPS_KEY=your_google_maps_api_key

# Password hashing salt (required — must match existing hashes on deployed DB)
PASSWORD_SALT=your_random_salt_here

# Google Analytics tracking ID (optional — omit to disable analytics)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Server port (default: 3000)
PORT=3000

# Data directory for SQLite DB and backups (default: ./data)
DATA_PATH=./data

# Set to "production" to enable HTTPS redirect and domain enforcement
# NODE_ENV=production

# Set to "true" to show maintenance page on the map host
# MAINTENANCE_MODE=true
