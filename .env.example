# ── Environment variables (same order as Render → Environment, alphabetical) ──
# Copy to `.env` and fill in. On Render, add the same keys in this order for easy comparison.
ACTIVITY_LOG_RETENTION_DAYS=7

DATA_PATH=./data

# ── Off-site DB backup (Phase 1 — optional, free tier: Cloudflare R2) ──
# Create bucket + API token at https://dash.cloudflare.com → R2
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Leave BACKUP_S3_ENDPOINT empty to skip remote upload (local-only backup unchanged).
#
# BACKUP_CLOUDFLARE_MAX_FILES=45  → after each upload keep only the 45 most recent
#   .db files in the bucket prefix (≈ 11 days at 4 backups/day). Same as legacy
#   BACKUP_REMOTE_MAX_OBJECTS / BACKUP_R2_MAX_FILES (first non-empty wins).
#   Set to 0 or omit all three to disable code-side pruning (R2 Lifecycle only).
#
# R2 Lifecycle rule (set once in the Cloudflare dashboard, no code needed):
#   Bucket → Settings → Lifecycle rules → Add rule
#   Prefix: leucaena-db/   Expiration: 30 days
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=leucaena-db
BACKUP_S3_REGION=auto
BACKUP_CLOUDFLARE_MAX_FILES=45
# BACKUP_R2_MAX_FILES=45
# BACKUP_REMOTE_MAX_OBJECTS=45

EMAIL_DAILY_LIMIT=80

GOOGLE_ANALYTICS_ID=

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

GOOGLE_MAPS_KEY=

IMMUTABLE_USER=

# Secret token to bypass maintenance mode. Access with ?bypass=YOUR_TOKEN to test during maintenance.
MAINTENANCE_BYPASS_TOKEN=

# Omit or set to false. Use true only to show the maintenance page on the map host.
MAINTENANCE_MODE=false

# Render sets NODE_ENV=production automatically. Uncomment locally only if you need prod-like behavior.
# NODE_ENV=production

PASSWORD_SALT=

PORT=3000

POLYGON_MIN_AREA_M2=20
# Max area per polygon in hectares (1 ha = 10 000 m²). Legacy POLYGON_MAX_AREA_M2 is read only if this is unset.
POLYGON_MAX_AREA_HA=80
# POLYGON_MAX_AREA_M2=800000

# ── Activity log retention (Phase 8) ──
# How many days to keep rows in activity_logs. Older rows are removed by:
#   (a) opportunistic purge every ~200 inserts (single small batch on hot path)
#   (b) periodic job every 6h (full purge in batches of 5000 rows)
# Lower = smaller DB, less audit history. Higher = bigger DB, more history.
# Minimum effective value is 1 day.
ACTIVITY_LOG_RETENTION_DAYS=7

RESEND_API_KEY=

# Sender shown in inboxes. Use a domain verified in Resend (Domains). Until then, for tests:
# RESEND_FROM=leucaena.earth <onboarding@resend.dev>
RESEND_FROM=leucaena.earth <noreply@leucaena.earth>

# ── Error monitoring (Phase 5 — optional, Sentry) ──
# Leave SENTRY_DSN empty to disable. Server boots fine in either case.
# Free tier (sentry.io): 5k errors/month + 10k transactions; more than enough.
# Create project at https://sentry.io/ → Settings → Projects → Client Keys (DSN).
#
# SENTRY_TRACES_SAMPLE_RATE: 0 = errors only (cheapest), 0.05 = 5% perf traces.
# SENTRY_RELEASE: optional release id (commit SHA); helps pinpoint regressions.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_RELEASE=
